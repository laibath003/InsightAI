<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/insight_background"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:background="@drawable/bg_insight_primary_button"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✦"
                android:textColor="@color/insight_surface"
                android:textSize="25sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="InsightAI"
                android:textColor="@color/insight_text"
                android:textSize="21sp"
                android:fontFamily="sans-serif-medium"
                android:fontWeight="700" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your AI research assistant"
                android:textColor="@color/insight_secondary_text"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonNewChat"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_insight_secondary_button"
            android:text="＋ New chat"
            android:textAllCaps="false"
            android:textColor="@color/insight_surface"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <!-- Research controls card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="@drawable/bg_insight_card">

        <!-- Clickable Research Mode header -->
        <LinearLayout
            android:id="@+id/layoutResearchModeHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="RESEARCH MODE"
                android:textColor="@color/insight_secondary_text"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/textResearchModeToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▲"
                android:textColor="@color/insight_violet_dark"
                android:textSize="14sp"
                android:paddingStart="12dp"
                android:paddingEnd="4dp" />

        </LinearLayout>

        <!-- Collapsible research controls -->
        <LinearLayout
            android:id="@+id/containerResearchControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Spinner
                android:id="@+id/spinnerResearchMode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:spinnerMode="dropdown"
                android:clickable="true"
                android:enabled="true" />

            <Button
                android:id="@+id/buttonSelectPdf"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_insight_secondary_button"
                android:text="+ Add PDF documents"
                android:textAllCaps="false"
                android:textColor="@color/insight_surface"
                android:textSize="13sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressUpload"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/insight_violet"
                android:visibility="gone" />

        </LinearLayout>

        <!-- PDF information: remains independently expandable -->
        <TextView
            android:id="@+id/textDocumentStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Select PDFs to research your documents."
            android:textColor="@color/insight_violet_dark"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/containerUploadedDocuments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Conversation area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YOUR CONVERSATION"
            android:textColor="@color/insight_secondary_text"
            android:textSize="10sp"
            android:letterSpacing="0.08"
            android:fontFamily="sans-serif-medium"
            android:paddingBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewMessages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:overScrollMode="ifContentScrolls" />

    </LinearLayout>

    <!-- Message composer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:padding="10dp"
        android:background="@drawable/bg_insight_card">

        <EditText
            android:id="@+id/editTextMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:maxHeight="120dp"
            android:gravity="top|start"
            android:padding="12dp"
            android:background="@drawable/bg_insight_input"
            android:hint="Ask anything or start researching..."
            android:textColor="@color/insight_text"
            android:textColorHint="@color/insight_secondary_text"
            android:textSize="14sp"
            android:inputType="textMultiLine|textCapSentences"
            android:imeOptions="actionSend"
            android:importantForAutofill="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <Button
                android:id="@+id/buttonStop"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_insight_secondary_button"
                android:text="■ Stop"
                android:textAllCaps="false"
                android:textColor="@color/insight_violet_dark"
                android:visibility="gone" />

            <Button
                android:id="@+id/buttonSend"
                android:layout_width="112dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_insight_primary_button"
                android:text="Send  ↑"
                android:textAllCaps="false"
                android:textColor="@color/insight_surface"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
